
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f8f9fa;
  color: #202124;
}

header {
  background: white;
  padding: 18px 25px;
  display: flex;
  align-items: center;
  gap: 25px;
  border-bottom: 1px solid #ddd;
}

.logo {
  color: #4285f4;
  font-size: 23px;
  font-weight: bold;
}

header span {
  color: #555;
}

main {
  padding: 45px 15px;
}

.file-card {
  background: white;
  max-width: 500px;
  margin: auto;
  padding: 30px;
  text-align: center;
  border-radius: 12px;
  box-shadow: 0 2px 12px #ddd;
}

.file-icon {
  font-size: 40px;
}

.file-card img {
  width: 100%;
  max-height: 350px;
  object-fit: contain;
  margin: 20px 0;
}

button {
  background: #1a73e8;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 13px 22px;
  margin: 8px;
  cursor: pointer;
  font-size: 15px;
}

button:hover {
  background: #1557b0;
}

#locationSection {
  border-top: 1px solid #ddd;
  margin-top: 25px;
  padding-top: 20px;
}

#locationSection[hidden] {
  display: none;
}

#status {
  overflow-wrap: anywhere;
  font-size: 13px;
}
